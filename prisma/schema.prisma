// Schema Prisma — portage du modele Access (voir
// 05_Documentation/02_Technique/Modele_Donnees.md et Specification_Version_Web.md).
// Les durees/heures sont stockees en MINUTES ENTIERES (Int), jamais en Date/Heure,
// pour eviter les pieges d'arithmetique horaire deja rencontres sur la version
// Access (voir Journal_Decisions.md D13).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleCode {
  ADMIN
  COMPTABLE
  PROFESSEUR
}

enum StatutProfesseur {
  PERMANENT
  VACATAIRE
  AUTRE // statut non reconnu : traite comme VACATAIRE et signale
}

enum StatutCours {
  PLANIFIE
  ARRIVEE_ENREGISTREE
  EN_COURS
  FIN_ENREGISTREE
  VALIDE
  A_CONTROLER
  NON_VALIDE
  INCOMPLET
  ABSENT
  CLOTURE
}

enum StatutPeriode {
  OUVERTE
  CLOTUREE
}

enum StatutRapport {
  OFFICIEL
  REMPLACE
}

enum SensArrondi {
  PLUS_PROCHE
  INFERIEUR
  SUPERIEUR
}

model Utilisateur {
  id               Int        @id @default(autoincrement())
  role             RoleCode
  professeur       Professeur? @relation(fields: [professeurId], references: [id])
  professeurId     Int?       @unique
  nomUtilisateur   String?    @unique // NULL pour un professeur (identifie par PIN)
  motDePasseHash   String?
  motDePasseSel    String?
  codePinHash      String?
  codePinSel       String?
  actif            Boolean    @default(true)
  dateCreation     DateTime   @default(now())
  dateModification DateTime?  @updatedAt
  dernierAcces     DateTime?

  coursValides     Cours[]      @relation("ValidePar")
  importsLog       ImportLog[]
  auditEntries     Audit[]
  periodesCloturees Periode[]  @relation("ClosePar")
  periodesReouvertes Periode[] @relation("RouvertePar")
  rapportsGeneres  Rapport[]
  jetonsPointageGeneres JetonPointage[]
  saisiesHeuresManuelles SaisieHeuresManuelle[]

  @@map("utilisateurs")
}

model Professeur {
  id                    Int       @id @default(autoincrement())
  matricule             String    @unique
  nom                   String
  prenom                String
  telephone             String?
  email                 String?
  statut                StatutProfesseur @default(VACATAIRE)
  tauxHoraireSpecifique Decimal?  @db.Decimal(10, 2)
  salaireFixeMensuel    Decimal?  @db.Decimal(10, 2) // obligatoire si PERMANENT (verifie en app)
  quotaHeuresMensuelMin Int?      // minutes ; obligatoire si PERMANENT
  actif                 Boolean   @default(true)
  dateCreation          DateTime  @default(now())
  dateModification      DateTime? @updatedAt

  // Matiere principale du professeur, saisie sur sa fiche - sert de dernier
  // recours pour la colonne "Matiere(s)" de la fiche d'emargement quand ni
  // les Cours valides ni l'emploi du temps n'en indiquent une (voir
  // src/app/api/admin/emargement/route.ts), ce qui evitait un "--" dans
  // cette colonne.
  matiere        Matiere?  @relation(fields: [matiereId], references: [id])
  matiereId      Int?
  utilisateur    Utilisateur?
  emploisDuTemps EmploiDuTemps[]
  cours          Cours[]
  saisiesManuelles SaisieHeuresManuelle[]
  affectations   AffectationEnseignement[]
  indisponibilites IndisponibiliteProfesseur[]

  @@map("professeurs")
}

model Classe {
  id         Int      @id @default(autoincrement())
  nomClasse  String   @unique
  niveau     String?
  actif      Boolean  @default(true)

  emploisDuTemps EmploiDuTemps[]
  cours          Cours[]
  affectations   AffectationEnseignement[]

  @@map("classes")
}

model Matiere {
  id        Int     @id @default(autoincrement())
  libelle   String  @unique
  actif     Boolean @default(true)

  // Comment compter les heures d'un professeur qui enseigne CETTE matiere a
  // plusieurs classes en simultane sur un meme creneau (ex. 3e1/3e2/3e3 en
  // meme temps - voir emploi du temps, qui l'autorise). PAR_CLASSE (defaut,
  // comportement historique) compte chaque classe separement.
  // UNE_FOIS_PAR_CRENEAU ne compte le temps qu'une fois par plage horaire
  // couverte, quel que soit le nombre de classes simultanees. Parametrable
  // PAR MATIERE (pas globalement) : une matiere ou la charge augmente
  // reellement avec le nombre de classes (ex. vacataire remplacant) peut
  // differer d'une matiere de surveillance/encadrement groupe (voir
  // src/lib/comptabilisation.ts). Voir /admin/matieres pour le reglage.
  modeComptageSimultane String @default("PAR_CLASSE")

  emploisDuTemps EmploiDuTemps[]
  cours          Cours[]
  affectations   AffectationEnseignement[]
  periodesEvitees MatierePeriodeEvitee[]
  saisiesManuelles SaisieHeuresManuelle[]
  professeurs    Professeur[]

  @@map("matieres")
}

/** Decoupage horaire de l'etablissement (sonnerie) : liste ordonnee des
 * periodes de cours, rendue explicite et modifiable plutot que de rester
 * implicite dans chaque ligne d'EmploiDuTemps (voir reflexion du generateur
 * automatique, Journal_Decisions). Sert de "grille" de creneaux possibles au
 * generateur ainsi qu'aux ecrans d'indisponibilite. */
model PeriodeGrille {
  id            Int     @id @default(autoincrement())
  ordre         Int
  libelle       String
  heureDebutMin Int
  heureFinMin   Int
  actif         Boolean @default(true)

  indisponibilites IndisponibiliteProfesseur[]
  matieresEvitees  MatierePeriodeEvitee[]

  @@map("periodes_grille")
}

/** Qui enseigne quoi a qui, et combien de seances par semaine - entree du
 * generateur automatique d'emploi du temps (le quota a placer). Une seance =
 * une periode de PeriodeGrille (pas de notion de bloc dans cette premiere
 * version). Un seul professeur par (classe, matiere) actif a la fois. */
model AffectationEnseignement {
  id                Int        @id @default(autoincrement())
  classe            Classe     @relation(fields: [classeId], references: [id])
  classeId          Int
  matiere           Matiere    @relation(fields: [matiereId], references: [id])
  matiereId         Int
  professeur        Professeur @relation(fields: [professeurId], references: [id])
  professeurId      Int
  seancesParSemaine Int
  actif             Boolean    @default(true)
  dateCreation      DateTime   @default(now())
  dateModification  DateTime?  @updatedAt

  @@unique([classeId, matiereId])
  @@map("affectations_enseignement")
}

/** Indisponibilite recurrente hebdomadaire d'un professeur (jour + periode) -
 * contrainte dure du generateur automatique : jamais place un professeur sur
 * un de ces creneaux. Distinct d'une absence datee (conge, maladie), hors
 * perimetre ici - coherent avec EmploiDuTemps qui est deja un modele
 * hebdomadaire recurrent, pas date. */
model IndisponibiliteProfesseur {
  id              Int           @id @default(autoincrement())
  professeur      Professeur    @relation(fields: [professeurId], references: [id])
  professeurId    Int
  jourSemaine     Int           // 1=Lundi ... 7=Dimanche
  periodeGrille   PeriodeGrille @relation(fields: [periodeGrilleId], references: [id])
  periodeGrilleId Int
  motif           String?

  @@unique([professeurId, jourSemaine, periodeGrilleId])
  @@map("indisponibilites_professeur")
}

/** Periodes a eviter pour une matiere, tous jours confondus (ex. jamais en
 * derniere periode) - contrainte souple du generateur automatique, prise en
 * compte dans le score de placement mais jamais garantie. */
model MatierePeriodeEvitee {
  id              Int           @id @default(autoincrement())
  matiere         Matiere       @relation(fields: [matiereId], references: [id])
  matiereId       Int
  periodeGrille   PeriodeGrille @relation(fields: [periodeGrilleId], references: [id])
  periodeGrilleId Int

  @@unique([matiereId, periodeGrilleId])
  @@map("matieres_periodes_evitees")
}

model EmploiDuTemps {
  id                 Int       @id @default(autoincrement())
  professeur         Professeur @relation(fields: [professeurId], references: [id])
  professeurId       Int
  classe             Classe     @relation(fields: [classeId], references: [id])
  classeId           Int
  matiere            Matiere    @relation(fields: [matiereId], references: [id])
  matiereId          Int
  jourSemaine        Int        // 1=Lundi ... 7=Dimanche
  heureDebutMin      Int        // minutes depuis minuit
  heureFinMin        Int        // minutes depuis minuit, doit etre > heureDebutMin
  dateDebutValidite  DateTime
  dateFinValidite    DateTime?  // NULL = sans fin
  actif              Boolean    @default(true)
  dateImport         DateTime?
  importLog          ImportLog? @relation(fields: [importLogId], references: [id])
  importLogId        Int?

  cours Cours[]

  @@index([professeurId, jourSemaine, dateDebutValidite])
  @@map("emplois_du_temps")
}

model Cours {
  id                  Int       @id @default(autoincrement())
  emploiDuTemps       EmploiDuTemps? @relation(fields: [emploiDuTempsId], references: [id])
  emploiDuTempsId     Int?
  professeur          Professeur @relation(fields: [professeurId], references: [id])
  professeurId        Int
  classe              Classe     @relation(fields: [classeId], references: [id])
  classeId            Int
  matiere             Matiere    @relation(fields: [matiereId], references: [id])
  matiereId           Int
  dateCours           DateTime   // partie date seule exploitee (00:00)
  heureDebutPrevueMin Int
  heureFinPrevueMin   Int
  heureArriveeReelle  DateTime?  // horodatage exact ecrit au clic, jamais deduit
  heureFinReelle      DateTime?  // idem
  dureePrevueMin      Int
  dureeReelleMin      Int?
  ecartArriveeMin     Int?
  ecartDepartMin      Int?
  dureeValideeMin     Int?       // seule valeur utilisee en comptabilisation
  statut              StatutCours @default(PLANIFIE)
  motifValidation     String?
  dateValidation      DateTime?
  validePar           Utilisateur? @relation("ValidePar", fields: [validateurId], references: [id])
  validateurId         Int?
  periode             Periode?   @relation(fields: [periodeId], references: [id])
  periodeId           Int?
  dateCreation        DateTime   @default(now())
  dateModification    DateTime?  @updatedAt

  // classeId inclus : un professeur peut avoir plusieurs classes en
  // simultane sur le meme creneau (voir emploi du temps), chacune generant
  // sa propre occurrence de Cours ce jour-la.
  @@unique([professeurId, dateCours, heureDebutPrevueMin, classeId])
  @@map("cours")
}

model RegleValidation {
  id                   Int      @id @default(autoincrement())
  toleranceArriveeMin   Int
  toleranceDepartMin    Int
  retardMaxAccepteMin   Int
  delaiAbsenceMin       Int
  arrondiMin            Int      @default(0)
  sensArrondi           SensArrondi @default(PLUS_PROCHE)
  tauxHoraireGeneral    Decimal  @db.Decimal(10, 2)
  dateApplication       DateTime
  actif                 Boolean  @default(true)
  dateCreation          DateTime @default(now())
  dateModification      DateTime? @updatedAt

  @@map("regles_validation")
}

model Periode {
  id                   Int       @id @default(autoincrement())
  libelle              String    @unique // ex. "2026-09"
  dateDebut            DateTime
  dateFin              DateTime
  statut               StatutPeriode @default(OUVERTE)
  dateCloture          DateTime?
  closePar             Utilisateur? @relation("ClosePar", fields: [closeParId], references: [id])
  closeParId           Int?
  dateReouverture       DateTime?
  rouvertePar          Utilisateur? @relation("RouvertePar", fields: [rouverteParId], references: [id])
  rouverteParId        Int?
  motifReouverture      String?
  tauxHoraireApplique   Decimal?  @db.Decimal(10, 2)

  cours   Cours[]
  rapports Rapport[]
  saisiesManuelles SaisieHeuresManuelle[]

  @@map("periodes")
}

/** Heures saisies manuellement pour un professeur sur une periode - sert a
 * rattraper des heures reellement effectuees mais jamais tracees par le
 * systeme (typiquement : les semaines d'enseignement avant la mise en
 * service de l'application, pour lesquelles aucun Cours n'a pu etre genere
 * faute d'emploi du temps importe a l'epoque). Une ligne = un jour reel
 * (date + heure d'arrivee + heure de depart, duree calculee) - comme un
 * releve de pointage reconstitue a la main plutot qu'un total global, pour
 * rester coherent avec la facon dont le reste de l'application raisonne
 * (Cours.heureArriveeReelle/heureFinReelle). S'ajoute aux minutes validees
 * automatiquement (Cours.statut=VALIDE) dans le calcul des honoraires de la
 * periode choisie - voir calculerComptabilisation. Motif obligatoire et
 * auteur trace : memes garde-fous que toute correction manuelle de donnees
 * dans l'application (D11). */
model SaisieHeuresManuelle {
  id              Int      @id @default(autoincrement())
  professeur      Professeur @relation(fields: [professeurId], references: [id])
  professeurId    Int
  periode         Periode  @relation(fields: [periodeId], references: [id])
  periodeId       Int
  date            DateTime // jour de la session (partie date seule)
  heureArriveeMin Int      // minutes depuis minuit
  heureDepartMin  Int      // minutes depuis minuit, > heureArriveeMin
  dureeMin        Int      // heureDepartMin - heureArriveeMin
  matiere         Matiere? @relation(fields: [matiereId], references: [id])
  matiereId       Int?     // optionnelle : seule source de matiere pour un prof sans emploi du temps/cours (voir fiche d'emargement)
  motif           String
  dateSaisie      DateTime @default(now())
  saisiePar       Utilisateur @relation(fields: [saisieParId], references: [id])
  saisieParId     Int

  @@map("saisies_heures_manuelles")
}

model Rapport {
  id                     Int       @id @default(autoincrement())
  numeroRapport          String    // RPT-AAAA-MM-NNNNNN
  version                Int       @default(1)
  periode                Periode   @relation(fields: [periodeId], references: [id])
  periodeId              Int
  typeRapport            String    // MENSUEL | HEBDOMADAIRE | PAR_PROFESSEUR | ANOMALIES
  dateGeneration         DateTime  @default(now())
  generePar              Utilisateur @relation(fields: [genereParId], references: [id])
  genereParId            Int
  heuresTotalesMin       Int?
  montantTotal           Decimal?  @db.Decimal(12, 2)
  donneesCanoniquesJson  String    // snapshot deterministe ayant servi au calcul du hash
  hashRapport            String    // SHA-256 hexadecimal
  codeVerification       String    // VFY-XXXX-XXXX
  statut                 StatutRapport @default(OFFICIEL)
  cheminPdf              String?
  cheminExcel            String?

  @@unique([numeroRapport, version])
  @@map("rapports")
}

model Audit {
  id              Int       @id @default(autoincrement())
  dateHeure       DateTime  @default(now())
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId   Int
  action          String
  tableConcernee  String?
  idEnregistrement Int?
  ancienneValeur  String?
  nouvelleValeur  String?
  motif           String?

  @@map("audit")
}

model ImportLog {
  id                      Int       @id @default(autoincrement())
  dateImport              DateTime  @default(now())
  importePar              Utilisateur? @relation(fields: [importeParId], references: [id])
  importeParId            Int?
  nomFichier              String?
  lignesLues              Int       @default(0)
  lignesImportees         Int       @default(0)
  lignesRejetees          Int       @default(0)
  detailErreurs           String?
  detailAvertissements    String?
  cleStockageFichier      String?   // objet dans le stockage S3-compatible (fichier Excel original)

  emploisDuTemps EmploiDuTemps[]

  @@map("imports_log")
}

model JourNonOuvre {
  id       Int      @id @default(autoincrement())
  dateJour DateTime @unique
  libelle  String

  @@map("jours_non_ouvres")
}

model Parametre {
  cle    String @id
  valeur String

  @@map("parametres")
}

/** Code quotidien (24h) protegeant l'acces au poste de pointage kiosque :
 * genere depuis l'espace admin, il doit etre saisi une fois par appareil
 * (voir src/lib/jetonPointage.ts - un cookie signe marque ensuite l'appareil
 * comme "de confiance" jusqu'a l'expiration de CE jeton precis, pas
 * jusqu'a sa propre date de validation). Seul le jeton le plus recent et
 * non expire est valide - en generer un nouveau invalide immediatement
 * le precedent, meme s'il n'avait pas encore expire. */
model JetonPointage {
  id           Int      @id @default(autoincrement())
  code         String
  genereLe     DateTime @default(now())
  expireLe     DateTime
  genereParId  Int
  generePar    Utilisateur @relation(fields: [genereParId], references: [id])

  @@map("jetons_pointage")
}
