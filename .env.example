# Base de donnees PostgreSQL. En local avec `docker compose up -d db`,
# utiliser la ligne ci-dessous telle quelle. En production (Neon, Supabase,
# Vercel Postgres...), remplacer par l'URL fournie par l'hebergeur.
DATABASE_URL="postgresql://heures:heures@localhost:5432/heures_enseignement"

# Avec Neon : DATABASE_URL = la connexion "pooled" (hote se terminant par
# -pooler), avec pgbouncer=true pour eviter les erreurs de prepared
# statements derriere le pooler. DIRECT_URL = la connexion directe (meme
# hote SANS -pooler), utilisee uniquement par `prisma migrate` - optionnel,
# necessaire seulement si DATABASE_URL passe par un pooler.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Notifications email (Resend, https://resend.com) : alerte l'administration
# quand l'application des regles de validation laisse des cours a controler
# manuellement. Facultatif - si absent, l'application des regles fonctionne
# normalement, seule la notification est desactivee.
# RESEND_API_KEY="re_..."
# NOTIFY_EMAIL_TO="directeur@exemple.com,comptable@exemple.com"
# NOTIFY_EMAIL_FROM="Kaloh Heures <onboarding@resend.dev>"

# Stockage objet S3-compatible (Neon Object Storage) : conserve le fichier
# Excel original de chaque import d'emploi du temps. Facultatif - si absent,
# l'import fonctionne normalement, seule la conservation du fichier original
# est desactivee.
# STORAGE_ENDPOINT="https://<branch-id>.storage.<region>.aws.neon.tech"
# STORAGE_REGION="us-east-2"
# STORAGE_BUCKET="uploads"
# STORAGE_ACCESS_KEY_ID="nak_live_..."
# STORAGE_SECRET_ACCESS_KEY="nsk_live_..."

# Secret de signature des sessions/jetons - generer une valeur aleatoire longue
# (ex: openssl rand -base64 32) et ne JAMAIS la commiter.
AUTH_SECRET="changez-moi-en-production"

# Utilises uniquement par prisma/seed.ts pour creer le premier compte admin.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changez-moi-8-caracteres-minimum"

# IMPORTANT : fuseau horaire de l'etablissement. "Aujourd'hui" cote pointage
# (src/lib/pointage.ts) est calcule a partir de l'heure LOCALE du serveur -
# sans ce reglage, un serveur deploye dans un autre fuseau decale la journee
# scolaire (minuit UTC != minuit a l'ecole). Exemple pour la Cote d'Ivoire :
TZ="Africa/Abidjan"
