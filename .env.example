# Base de donnees PostgreSQL. En local avec `docker compose up -d db`,
# utiliser la ligne ci-dessous telle quelle. En production (Neon, Supabase,
# Vercel Postgres...), remplacer par l'URL fournie par l'hebergeur.
DATABASE_URL="postgresql://heures:heures@localhost:5432/heures_enseignement"

# Secret de signature des sessions/jetons - generer une valeur aleatoire longue
# (ex: openssl rand -base64 32) et ne JAMAIS la commiter.
AUTH_SECRET="changez-moi-en-production"

# Utilises uniquement par prisma/seed.ts pour creer le premier compte admin.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changez-moi-8-caracteres-minimum"

# IMPORTANT : fuseau horaire de l'etablissement. "Aujourd'hui" cote pointage
# (src/lib/pointage.ts) est calcule a partir de l'heure LOCALE du serveur -
# sans ce reglage, un serveur deploye dans un autre fuseau decale la journee
# scolaire (minuit UTC != minuit a l'ecole). Exemple pour la Cote d'Ivoire :
TZ="Africa/Abidjan"
